# Atlas Chokepoint — miljövariabler (alla valfria; allt utom live-AIS funkar helt utan)

# --- Live-AIS ---
# AISStream (gratis nyckel: aisstream.io). Utan nyckel: inga AISStream-fartyg.
AISSTREAM_API_KEY=

# Prenumerationsläge: chokepoints (~2-3k fartyg) | corridors (~10-15k, standard) | global (max)
ATLAS_AIS_MODE=corridors
# Tak för snapshotet (höj till 200000 för global)
ATLAS_AIS_MAX=25000
# Sekunder mellan snapshot-skrivningar (höj till ~12 för global — JSON-dumpen är dyr)
ATLAS_AIS_WRITE_EVERY=4

# BarentsWatch (norska EEZ + Svalbard) — gratis konto på developer.barentswatch.no.
# Client ID syns i portalen under "My clients"; SECRET visas bara EN gång när den
# skapas ("Add new client secret") — klistra in värdet här, inte dess Id-nummer.
BARENTSWATCH_CLIENT_ID=
BARENTSWATCH_CLIENT_SECRET=
# Scope: klienter skapade i portalen har ofta "api"; koden provar ais → api automatiskt.
#BARENTSWATCH_SCOPE=api

# Global Fishing Watch — loitering-/omlastningsevents ur satellit-AIS.
# Gratis token (icke-kommersiellt): globalfishingwatch.org/our-apis → registrera
# → skapa token → klistra in här. Utan token visas bara egen-AIS + NGA-varningar.
GFW_API_TOKEN=

# --- Övrigt ---
# Cesium Ion-token (valfri; ger terräng)
#CESIUM_ION_TOKEN=
# PortWatch-historikens startdatum (standard 2019-01-01 = hela historiken)
#ATLAS_PW_SINCE=2019-01-01
# Server
#ATLAS_HOST=127.0.0.1
#ATLAS_PORT=8060

# Egen AIS-catcher-station (github.com/jvde-github/AIS-catcher + RTL-SDR):
# stationens lokala webserver, t.ex. http://127.0.0.1:8100 — mergas in i live-bilden.
# Registrera stationen på aiscatcher.org (-X <sharing key>) för community-feeden.
#ATLAS_AISCATCHER_URL=http://127.0.0.1:8100

# Singapore OCEANS-X (oceans-x.mpa.gov.sg): fartygspositioner i Singapores
# hamnvatten var 3:e min — registrera utvecklarkonto, dokumentation i portalen.
# Japan MSIL (portal.msil.go.jp): kustbevakningens GeoJSON-API:er, gratis nyckel.

# --- CJT-nowcast (cjt_nowcast/) ---
# stooq-nyckel: hämtas via CAPTCHA på https://stooq.com/q/d/?s=spy.us&get_apikey
#STOOQ_API_KEY=
# CJT:s symbol hos stooq inkl. börssuffix (Toronto-suffixet är odokumenterat — verifiera på stooq.com)
#CJT_STOOQ_SYMBOL=
